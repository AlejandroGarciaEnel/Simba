# Copia este fichero a .env y rellena los valores reales
# NUNCA subas .env a un repositorio

# --- Conexión Oracle ---
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_USER=monitor_user
DB_PASSWORD=

# --- Oracle Instant Client (opcional) ---
# Descomenta solo si necesitas modo Thick (p. ej. error DPY-3015 con verificadores de contraseña antiguos).
# Si se omite, python-oracledb usa modo Thin y no requiere Instant Client.
# ORACLE_CLIENT_DIR=C:\oracle\instantclient_23_0

# --- GenAI Hub ---
LLM_PROVIDER=genaihub
GENAIHUB_MODEL=claude45haiku
GENAIHUB_BASE_URL=https://genaihubaws-dev.enelint.global
GENAIHUB_TENANT_ID=enelcom.onmicrosoft.com
GENAIHUB_TOKEN_URL=https://login.microsoftonline.com/enelcom.onmicrosoft.com/oauth2/v2.0/token
GENAIHUB_SCOPE=api://<app-id-uri>/.default
GENAIHUB_CLIENT_ID=
GENAIHUB_CLIENT_SECRET=
SSL_VERIFY=false

# --- API backend (interface/backend/main.py) ---
# Riesgo aceptado: valores por defecto abiertos, válidos solo para uso local.
# Antes de un despliegue expuesto a red compartida/producción, restringir:
#   SIMBA_CORS_ALLOWED_ORIGINS a orígenes concretos (ej: https://miapp.interna.com,https://otro.dominio.com)
#   SIMBA_HOST a la interfaz de red real (evitar 0.0.0.0 sin firewall/proxy delante)
SIMBA_CORS_ALLOWED_ORIGINS=*
SIMBA_HOST=127.0.0.1
SIMBA_PORT=8000

# --- Consultas Oracle (db/queries.py) ---
# Timeout por query en milisegundos (python-oracledb Cursor.callTimeout).
SIMBA_DB_QUERY_TIMEOUT_MS=5000

# --- Informes AWR subidos (RF021) ---
# Tamaño máximo por fichero (MB) y número máximo de informes conservados en awr/
SIMBA_AWR_MAX_MB=20
SIMBA_AWR_MAX_FILES=50
# Seguimiento en vivo tras analizar un AWR subido desde la web (consultas de solo lectura a la BD).
# Poner a false para desactivarlo. Presupuesto de tiempo total del seguimiento, en segundos.
SIMBA_AWR_FOLLOWUP=true
SIMBA_AWR_FOLLOWUP_BUDGET_S=30

# --- Informe HTML (report/generator.py) ---
# Esquema usado para el top de tablas por tamaño
REPORT_OWNER=ENET
