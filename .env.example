# Copia este fichero a .env y rellena los valores reales
# NUNCA subas .env a un repositorio

# --- Conexión Oracle ---
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=ORCLPDB1
DB_USER=monitor_user
DB_PASSWORD=

# --- GenAI Hub ---
LLM_PROVIDER=genaihub
GENAIHUB_MODEL=claude45haiku
GENAIHUB_BASE_URL=https://genaihubaws-dev.enelint.global
GENAIHUB_TENANT_ID=enelcom.onmicrosoft.com
GENAIHUB_TOKEN_URL=https://login.microsoftonline.com/enelcom.onmicrosoft.com/oauth2/v2.0/token
GENAIHUB_SCOPE=api://<app-id-uri>/.default
GENAIHUB_CLIENT_ID=
GENAIHUB_CLIENT_SECRET=
SSL_VERIFY=false

# --- API backend (interface/backend/main.py) ---
# Riesgo aceptado: valores por defecto abiertos, válidos solo para uso local.
# Antes de un despliegue expuesto a red compartida/producción, restringir:
#   SIMBA_CORS_ALLOWED_ORIGINS a orígenes concretos (ej: https://miapp.interna.com,https://otro.dominio.com)
#   SIMBA_HOST a la interfaz de red real (evitar 0.0.0.0 sin firewall/proxy delante)
SIMBA_CORS_ALLOWED_ORIGINS=*
SIMBA_HOST=127.0.0.1
SIMBA_PORT=8000

# --- Consultas Oracle (db/queries.py) ---
# Timeout por query en milisegundos (se aplica como Connection.callTimeout de cx_Oracle).
SIMBA_DB_QUERY_TIMEOUT_MS=5000

# --- Revisión de estado (health/checker.py) ---
# Minutos que se reutiliza la última revisión antes de volver a consultar Oracle
SIMBA_HEALTH_CACHE_MINUTES=10

# --- Acceso web (interface/backend/auth.py) ---
# Fichero JSON con los usuarios web (contraseñas con hash PBKDF2). Por defecto data/users.json
# SIMBA_USERS_FILE=data/users.json
# Horas de validez de la sesión web
SIMBA_SESSION_HOURS=8
# Poner a true cuando la web se sirva por HTTPS (cookie solo por canal seguro)
SIMBA_COOKIE_SECURE=false

# Informe semanal de queries y seguimiento de mejoras (solo lectura)
# SIMBA_QUERY_REPORTS_DIR=/ruta/PRAGU4E_Planner/entrada
# SIMBA_QUERY_TRACKING_FILE=/ruta/PRAGU4E_Planner/PRAGU4E_Seguimiento.xlsx

# --- Alertas de bloqueo por correo (desactivadas por defecto) ---
# Avisa si una sesión bloquea a otras durante más de SIMBA_ALERT_BLOCK_S segundos. Pide el SMTP al equipo de IT.
SIMBA_ALERT_ENABLED=false
SIMBA_ALERT_BLOCK_S=300
SIMBA_ALERT_INTERVAL_S=60
SIMBA_ALERT_REPEAT_MIN=30
SIMBA_SMTP_HOST=
SIMBA_SMTP_PORT=587
SIMBA_SMTP_STARTTLS=true
SIMBA_SMTP_USER=
SIMBA_SMTP_PASSWORD=
SIMBA_ALERT_FROM=
SIMBA_ALERT_TO=
